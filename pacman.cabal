cabal-version:       2.4
name:                pacman
version:             1.0.0
synopsis:            Pac-Man with a twist (candy!), written in Haskell with Gloss
author:              Matthieu Meylemans, Aidan Wetsteijn
category:            Game
build-type:          Simple
extra-source-files:  README.md
                     levels/*.txt

executable pacman
  main-is:             Main.hs
  hs-source-dirs:      src
  other-modules:       Config
                     , Controller
                     , FileIO
                     , Game
                     , Ghost
                     , Items
                     , Level
                     , Maze
                     , Model
                     , Player
                     , View
  build-depends:       base >= 4 && < 5
                     , gloss
                     , random
                     , directory
                     , filepath
  default-language:    Haskell2010
  ghc-options:         -Wall
